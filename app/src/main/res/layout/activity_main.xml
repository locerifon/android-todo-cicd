<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA"
    tools:context=".MainActivity">

    <!-- Заголовок и бейдж версии -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TodoApp Production"
            android:textColor="#1F2937"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E5E7EB"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="v2.1.12"
            android:textColor="#374151"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/subText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Пострелизное сопровождение: CI/CD &amp; Remote Config"
        android:textColor="#6B7280"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Список задач (Основной функционал) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Текущие задачи"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Подготовить релизный бандл AAB"
                android:textColor="#374151"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Настроить автоматический changelog"
                android:textColor="#374151"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Проверить переключатели Feature Toggles"
                android:textColor="#2563EB"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Фича 1: new_feature_enabled (Кнопка быстрой отправки/экспорта) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShareFeature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#2563EB"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#EFF6FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Новая функция: Быстрый экспорт"
                android:textColor="#1D4ED8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Функция активирована удаленно через Firebase Remote Config!"
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Поделиться списком задач"
                app:cornerRadius="8dp"
                android:backgroundTint="#2563EB" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Фича 2: stats_banner_enabled (Виджет аналитики продуктивности) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatsFeature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#10B981"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#ECFDF5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Аналитика недели (Beta)"
                android:textColor="#047857"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выполнено 94% задач. Продуктивность на максимуме!"
                android:textColor="#059669"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Нижняя панель локального управления флагами (для тестирования) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/toggleControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠 Тестирование флагов Remote Config:"
            android:textColor="#4B5563"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNewFeature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Флаг: new_feature_enabled"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStatsFeature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Флаг: stats_banner_enabled"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
