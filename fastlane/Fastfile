default_platform(:android)

platform :android do
  desc "Deploy Release APK and Deploy to Firebase App Distribution"
  lane :distribute do
    gradle(
      task: "assemble",
      build_type: "Release"
    )
    if ENV["FIREBASE_SERVICE_ACCOUNT"] && ENV["FIREBASE_SERVICE_ACCOUNT"].length > 10
      firebase_app_distribution(
        app: ENV["FIREBASE_APP_ID"] || "1:1234567890:android:abcdef",
        service_credentials_file_content: ENV["FIREBASE_SERVICE_ACCOUNT"],
        groups: "qa-team, beta-testers",
        android_artifact_type: "APK",
        release_notes: "Автоматическая сборка из ветки main через GitHub Actions & Fastlane"
      )
    else
      UI.message("FIREBASE_SERVICE_ACCOUNT не настроен, пропуск загрузки в Firebase.")
    end
  end

  desc "Сборка релизного бандла AAB"
  lane :bundle do
    gradle(
      task: "bundle",
      build_type: "Release"
    )
  end

  desc "Deploy a new Internal Test Build with Automated Changelog"
  lane :internal do
    # Сборка релизного бандла AAB
    gradle(task: "bundleRelease")

    # Получение versionCode из Git коммитов
    version_code = sh("git rev-list --count HEAD").strip
    UI.message("Deploying internal build with versionCode: #{version_code}")

    # Подготовка changelogs/XX.txt для Google Play Console
    changelog_dir = "metadata/android/en-US/changelogs"
    sh("mkdir -p #{changelog_dir}")
    changelog_file = "#{changelog_dir}/#{version_code}.txt"

    if File.exist?("../CHANGELOG.md")
      changelog_text = File.read("../CHANGELOG.md").split(/^## /)[1] || "Релиз #{version_code}"
      File.write(changelog_file, changelog_text.strip)
      UI.message("Changelog generated for Play Console: #{changelog_file}")
    end

    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      json_key_data: ENV["PLAY_STORE_JSON_KEY"]
    )
  end

  desc "Promote from Internal to Production"
  lane :promote_prod do
    supply(
      track: 'internal',
      track_promote_to: 'production',
      version_code: google_play_track_version_codes(track: 'internal').last,
      rollout: '1.0',
      json_key_data: ENV['PLAY_STORE_JSON_KEY']
    )
  end
end
